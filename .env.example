# PayScope Environment Configuration Template
# Copy this file to .env for local development. Do not commit actual passwords or secrets.

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
API_V1_STR=/api/v1
PROJECT_NAME="PayScope API"

# CORS Configuration (Production Vercel Frontend & Local Development)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,https://pay-scope-lake.vercel.app,https://payscope.vercel.app

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=mandatelens
POSTGRES_USER=mandatelens_dev
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql+psycopg://mandatelens_dev:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/mandatelens
TEST_DATABASE_URL=postgresql+psycopg://mandatelens_dev:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/mandatelens_test

# Frontend Configuration
NEXT_PUBLIC_APP_NAME="PayScope"
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional graph projection (credentials remain on the backend)
NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_LOCAL_ONLY
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=3
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=4
NEO4J_QUERY_TIMEOUT=4
NEO4J_SYNC_QUERY_TIMEOUT=30
NEO4J_SYNC_BATCH_SIZE=500

# Authentication: generate a unique secret with secrets.token_urlsafe(48).
API_SESSION_SECRET=
FIREBASE_PROJECT_ID=
ALLOW_GUEST_SESSIONS=true
RUN_MIGRATIONS=true
